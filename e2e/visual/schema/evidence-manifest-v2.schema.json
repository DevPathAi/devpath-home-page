{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leva.ai.kr/schemas/home-visual-a11y-evidence-v2.json",
  "title": "Sanitized Home visual/a11y evidence manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "document_type", "binding", "runtime", "theme_coverage", "baseline_review", "summary", "cases", "privacy"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "document_type": { "enum": ["home-visual-evidence", "home-a11y-evidence"] },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "home_source_sha", "candidate_spec_sha256", "case_catalog_sha256", "font_manifest_sha256"],
      "properties": {
        "repository": { "const": "DevPathAi/devpath-home-page" },
        "home_source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "candidate_spec_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "case_catalog_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "font_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "theme_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": { "const": "covered" },
        "dark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "approval"],
          "properties": {
            "status": { "const": "not_applicable" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
            "approval": {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "status", "owner", "artifact"],
              "properties": {
                "required": { "const": true },
                "status": { "const": "pending" },
                "owner": { "const": "product-design" },
                "artifact": { "type": "null" }
              }
            }
          }
        }
      }
    },
    "baseline_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "review_id"],
      "properties": {
        "status": { "enum": ["missing", "pending_external_review", "approved"] },
        "review_id": { "type": ["string", "null"], "maxLength": 80 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "passed", "failed"],
      "properties": {
        "required": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "cases": { "type": "array", "minItems": 1 },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "contains_raw_content"],
      "properties": {
        "classification": { "const": "sanitized-aggregate-only" },
        "contains_raw_content": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "document_type": { "const": "home-visual-evidence" } } },
      "then": { "properties": { "cases": { "items": { "$ref": "#/$defs/visualCase" } } } }
    },
    {
      "if": { "properties": { "document_type": { "const": "home-a11y-evidence" } } },
      "then": { "properties": { "cases": { "items": { "$ref": "#/$defs/a11yCase" } } } }
    }
  ],
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "playwright_version", "locale", "timezone_id", "device_scale_factor", "color_scheme", "reduced_motion", "animations", "clock", "network_policy", "workers"],
      "properties": {
        "browser": { "const": "chromium" },
        "playwright_version": { "const": "1.61.1" },
        "locale": { "const": "ko-KR" },
        "timezone_id": { "const": "UTC" },
        "device_scale_factor": { "const": 1 },
        "color_scheme": { "const": "light" },
        "reduced_motion": { "const": "reduce" },
        "animations": { "const": "disabled" },
        "clock": { "const": "2026-08-16T00:00:00.000Z" },
        "network_policy": { "const": "loopback-only" },
        "workers": { "const": 1 }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "enum": [320, 600, 840, 1240] },
        "height": { "type": "integer", "minimum": 720, "maximum": 1200 }
      }
    },
    "visualCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "theme", "viewport", "check_count", "failed_check_count", "artifact_sha256"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "status": { "enum": ["passed", "failed"] },
        "theme": { "const": "light" },
        "viewport": { "$ref": "#/$defs/viewport" },
        "check_count": { "type": "integer", "minimum": 1 },
        "failed_check_count": { "type": "integer", "minimum": 0 },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "a11yCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "theme", "viewport", "check_count", "failed_check_count", "violation_counts"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "status": { "enum": ["passed", "failed"] },
        "theme": { "const": "light" },
        "viewport": { "$ref": "#/$defs/viewport" },
        "check_count": { "type": "integer", "minimum": 1 },
        "failed_check_count": { "type": "integer", "minimum": 0 },
        "violation_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["critical", "serious", "moderate", "minor", "total"],
          "properties": {
            "critical": { "type": "integer", "minimum": 0 },
            "serious": { "type": "integer", "minimum": 0 },
            "moderate": { "type": "integer", "minimum": 0 },
            "minor": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
