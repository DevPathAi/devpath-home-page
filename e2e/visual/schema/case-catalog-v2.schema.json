{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leva.ai.kr/schemas/home-visual-a11y-case-catalog-v2.json",
  "title": "Home visual/a11y case catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "document_type", "surface", "theme_coverage", "baseline_policy", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "document_type": { "const": "home-visual-a11y-case-catalog" },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "route", "build"],
      "properties": {
        "repository": { "const": "DevPathAi/devpath-home-page" },
        "route": { "const": "/" },
        "build": { "const": "production-dist" }
      }
    },
    "theme_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "required" } }
        },
        "dark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "approval"],
          "properties": {
            "status": { "const": "not_applicable" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
            "approval": {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "status", "owner", "artifact"],
              "properties": {
                "required": { "const": true },
                "status": { "const": "pending" },
                "owner": { "const": "product-design" },
                "artifact": { "type": "null" }
              }
            }
          }
        }
      }
    },
    "baseline_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "update_in_ci", "review_metadata_required"],
      "properties": {
        "platform": { "type": "string", "pattern": "^mcr\\.microsoft\\.com/playwright:v1\\.61\\.1-noble@sha256:[0-9a-f]{64}$" },
        "update_in_ci": { "const": false },
        "review_metadata_required": { "const": true }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "status", "theme", "route", "viewport", "checks"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "kind": { "enum": ["visual", "a11y"] },
          "status": { "const": "required" },
          "theme": { "const": "light" },
          "route": { "const": "/" },
          "viewport": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height"],
            "properties": {
              "width": { "enum": [320, 600, 840, 1240] },
              "height": { "type": "integer", "minimum": 720, "maximum": 1200 }
            }
          },
          "artifact": { "type": "string", "pattern": "^[a-z0-9-]+\\.png$" },
          "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } }
        }
      }
    }
  }
}
